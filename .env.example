# Copy to .env and fill in. Never commit .env — it holds live keys.

# Groq drives live conversation: lowest measured time-to-first-token.
# --- LLM ----------------------------------------------------------------
# Which provider writes what the caller hears. sarvam speaks the Indian languages
# natively; groq is faster and does not spend Sarvam credits.
LLM_PROVIDER=sarvam

# Intent classification only. Its output is a JSON label nobody hears, so keep it on
# Groq: it halves Sarvam credit use per turn and is faster besides.
FAST_LLM_PROVIDER=groq

GROQ_API_KEY=

# NVIDIA NIM: development provider, Groq failover, and the deep-reasoning subagent.
NVIDIA_API_KEY=

# Deep reasoning is OFF by default: the fast Groq path answers in hundreds of
# milliseconds, the subagent takes 6-25 s. Set to true only where that wait is
# acceptable. Brain(deep_reason=True/False) overrides this per instance.
DEEP_REASON_ENABLED=false

# Deep-reasoning subagent, run off the conversational hot path.
# GLM-5.2 was the original choice; NVIDIA retired it on 2026-08-21 (410 Gone).
SUBAGENT_MODEL=minimaxai/minimax-m3
SUBAGENT_FALLBACK_MODEL=moonshotai/kimi-k3

# --- speech -------------------------------------------------------------

# Sarvam: streaming STT/TTS.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# anushka is a bulbul:v2 voice and is rejected by v3. See BULBUL_V3_SPEAKERS.
SARVAM_SPEAKER=priya

# Characters TTS buffers before synthesising. 50 is a hard floor: lower values are
# rejected with a 422 that names no parameter. Verified live — 24 fails, 50 works.
SARVAM_MIN_BUFFER_SIZE=50
SARVAM_MAX_CHUNK_LENGTH=150
