# Copy to .env and fill in. Never commit .env — it holds live keys.

# Groq drives live conversation: lowest measured time-to-first-token.
GROQ_API_KEY=

# NVIDIA NIM: development provider, Groq failover, and the deep-reasoning subagent.
NVIDIA_API_KEY=

# Deep-reasoning subagent, run off the conversational hot path.
# GLM-5.2 was the original choice; NVIDIA retired it on 2026-08-21 (410 Gone).
SUBAGENT_MODEL=minimaxai/minimax-m3
SUBAGENT_FALLBACK_MODEL=moonshotai/kimi-k3
